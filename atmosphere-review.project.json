{
  "name": "DoubleLifeM7Review",
  "globIgnorePaths": ["src/server/Main.server.luau"],
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {"DoubleLifeShared": {"$path": "src/shared"}},
    "ServerScriptService": {
      "DoubleLifeServer": {"$path": "src/server", "Main": {"$path": "tests/InactiveMain.server.luau", "$properties": {"Disabled": true}}},
      "M7ReviewTests": {"$path": "tests/m7review", "MemoryStore": {"$path": "tests/MemoryStore.luau"}},
      "M7Audit": {"$path": "tests/M7Audit.server.luau"}
    },
    "StarterPlayer": {"$properties": {"CharacterWalkSpeed": 16}, "StarterPlayerScripts": {
      "DoubleLifeClient": {"$path": "src/client"}, "M7ReviewClient": {"$path": "tests/M7Review.client.luau"},
      "M7ClientAudit": {"$path": "tests/M7Audit.client.luau"}
    }}
  }
}
