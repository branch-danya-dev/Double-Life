{
  "name": "DoubleLife",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "DoubleLifeShared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "DoubleLifeServer": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "DoubleLifeClient": {
          "$path": "src/client"
        }
      }
    },
    "Chat": {
      "$className": "Chat",
      "$properties": {
        "LoadDefaultChat": false
      }
    },
    "TextChatService": {
      "$className": "TextChatService",
      "$properties": {
        "ChatVersion": "TextChatService",
        "CreateDefaultTextChannels": false,
        "CreateDefaultCommands": false
      },
      "ChatWindowConfiguration": {
        "$className": "ChatWindowConfiguration",
        "$properties": {
          "Enabled": false
        }
      },
      "ChatInputBarConfiguration": {
        "$className": "ChatInputBarConfiguration",
        "$properties": {
          "Enabled": false
        }
      },
      "BubbleChatConfiguration": {
        "$className": "BubbleChatConfiguration",
        "$properties": {
          "Enabled": false
        }
      },
      "ChannelTabsConfiguration": {
        "$className": "ChannelTabsConfiguration",
        "$properties": {
          "Enabled": false
        }
      }
    }
  }
}
