{
  "name": "DoubleLifeM4Tests",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "DoubleLifeShared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "DoubleLifeServer": {
        "$path": "src/server",
        "Main": {
          "$className": "Script",
          "$properties": {
            "Disabled": true
          }
        }
      },
      "M4Tests": {
        "$path": "tests/m4",
        "MemoryStore": {
          "$path": "tests/MemoryStore.luau"
        }
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "DoubleLifeClient": {
          "$path": "src/client"
        },
        "M4ClientAudit": {
          "$path": "tests/M4Client.client.luau"
        }
      }
    },
    "Chat": {
      "$className": "Chat",
      "$properties": {
        "LoadDefaultChat": false
      }
    },
    "TextChatService": {
      "$className": "TextChatService",
      "$properties": {
        "ChatVersion": "TextChatService",
        "CreateDefaultTextChannels": false,
        "CreateDefaultCommands": false
      },
      "ChatWindowConfiguration": {
        "$className": "ChatWindowConfiguration",
        "$properties": {
          "Enabled": false
        }
      },
      "ChatInputBarConfiguration": {
        "$className": "ChatInputBarConfiguration",
        "$properties": {
          "Enabled": false
        }
      },
      "BubbleChatConfiguration": {
        "$className": "BubbleChatConfiguration",
        "$properties": {
          "Enabled": false
        }
      },
      "ChannelTabsConfiguration": {
        "$className": "ChannelTabsConfiguration",
        "$properties": {
          "Enabled": false
        }
      }
    }
  }
}
