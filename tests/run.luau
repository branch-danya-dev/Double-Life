local Config = require("../src/shared/Config")
local Policy = require("../src/server/GuardPolicy")
local Ledger = require("../src/server/RequestLedger")
local count = 0
local function check(condition, message)
    assert(condition, message)
    count += 1
end

local guard = Policy.new(Config)
check(guard.state == "Patrol" and guard.zone == "Corridor", "autonomous start")
check(guard:investigate("Glass", "table", 0), "first noise")
local deadline = guard.deadline
check(not guard:investigate("Window", "window", 4), "busy guard cannot stack distractions")
check(guard.deadline == deadline and guard.target == "table", "noise cannot extend investigation")
check(not guard:command("zone", "Foyer", 4), "owner cannot interrupt investigation")
guard:beginReturn(18)
check(not guard:investigate("Glass", "table", 19), "return cannot be interrupted")
guard:resume(24)
check(not guard:investigate("Window", "window", 35), "mandatory patrol rest")
check(not guard:investigate("Glass", "table", 36), "per-source cooldown")
check(guard:investigate("Window", "window", 36), "another event after rest")
guard:beginReturn(54)
guard:resume(55)
check(guard:command("zone", "Foyer", 56), "one patrol zone selected")
check(not guard:command("inspect", "study", 57), "commands share cooldown")
check(not guard:command("zone", "All", 81), "invalid zone rejected")
check(guard:command("inspect", "study", 81), "temporary owner inspection")
check(not guard:command("inspect", "study", 110), "even expired cooldown cannot extend busy state")

local ledger = Ledger.new(Config)
local first = ledger:create(10, 1, 0)
check(first ~= nil, "public request independent of role")
check(not ledger:create(10, 2, 1), "one active per guest")
check(not ledger:accept(10, 1, false), "cannot fulfill own request")
check(not ledger:accept(0, 7, true), "NPC allows staff to accept first")
check(ledger:accept(40, 2, false) == first, "staff claims request")
check(not ledger:deliver(first, 40, 3), "delivery before pickup rejected")
check(not ledger:pickup(first, 41, 3), "wrong executor rejected")
check(ledger:pickup(first, 40, 3), "server pickup")
check(not ledger:pickup(first, 40, 4), "cannot duplicate pickup")
check(ledger:deliver(first, 40, 8), "server delivery")
check(ledger.scores[40] == 10, "session reward")
check(not ledger:deliver(first, 40, 9) and ledger.scores[40] == 10, "no replay reward")
check(not ledger:create(10, 2, 44), "cooldown survives completion")
local second = ledger:create(10, 2, 45)
check(second ~= first, "next request after cooldown")
check(ledger:accept(40, 46, false) == second, "staff accepts another")
ledger:pickup(second, 40, 47)
ledger:remove(40, 48)
check(second.state == "Queued" and not second.executor, "disconnect requeues carried order")
check(ledger.scores[40] == nil, "points are session only")
check(ledger:accept(0, 56, true) == second, "NPC takes abandoned staff request")
check(ledger:pickup(second, 0, 57), "NPC pickup")
ledger:remove(10, 58)
check(not ledger:deliver(second, 0, 59), "departed guest cannot receive delivery")
check(not ledger:assigned(0), "executor freed after guest disconnect")
local expired = ledger:create(11, 1, 60)
ledger:accept(0, 68, true)
check(not ledger:pickup(expired, 0, 150), "deadline enforced before cleanup tick")
check(#ledger:expire(150) == 1 and not ledger.requests[11], "stale requests expire")
for id = 1, Config.REQUEST_LIMIT do check(ledger:create(id, 1, 200) ~= nil, "bounded queue slot") end
check(not ledger:create(99, 1, 200), "global queue limit")
print("PASS: " .. count .. " M1 policy and request assertions")
