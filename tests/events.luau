local Config = require("../src/shared/Config")
local Policy = require("../src/server/EventPolicy")
local Practice = require("../src/server/PracticePolicy")
local Clock = require("../src/server/SessionClock")
local count = 0
local function check(ok, message) assert(ok, message); count += 1 end
for _, role in ipairs({"Spy", "Guest", "Staff", "CounterAgent", "Waiting"}) do
    local p = Policy.new(Config)
    check(not p:start(role, true, "Relic", 0), "non-owner cannot start " .. role)
    check(p.used == 0, "rejection consumes no event")
end
local p = Policy.new(Config)
check(not p:start("Owner", false, "Relic", 0), "owner needs active participant permission")
check(not p:start("Owner", true, "Unknown", 0), "unknown event denied")
check(p:start("Owner", true, "Relic", 0), "owner chooses relic")
check(p.phase == "Announcing" and p.used == 1, "announcement before interaction")
check(not p:pickup(1, true), "relic cannot be picked up during announcement")
check(not p:start("Owner", true, "Music", 1), "only one event at a time")
check(p:advance(4) == nil and p.phase == "Announcing", "announcement has a deadline")
check(p:advance(5) == "Running" and p.endsAt == 65, "sixty-second reachable search")
check(not p:pickup(99, false), "late join/detained player cannot pick up")
for id = 1, 5 do
    local ok, first = p:pickup(id, true)
    check(ok and first, "each role may participate via server permission")
    check(not p:pickup(id + 1, true), "one physical carrier")
    check(p:drop(id), "carrier can restore relic availability")
end
check(p:pickup(1, true), "same player can recover a dropped relic")
check(not p:deliver(2, true, 20), "non-carrier cannot deliver")
check(not p:deliver(1, false, 20), "council cannot deliver")
check(p:deliver(1, true, 20), "carrier delivery finishes event")
check(p.scores[1] == 15 and p.scores[2] == 3, "one award per participant and delivery bonus")
check(not p:deliver(1, true, 21) and not p:finish(22, false) and p.scores[1] == 15, "replays cannot award again")
check(not p:start("Owner", true, "Music", 22), "finished display prevents immediate start")
p:advance(26)
check(p.phase == "Cooldown", "short result then cooldown")
p:advance(74)
check(not p:start("Owner", true, "Music", 74), "55-second cooldown after completion")
p:advance(75)
check(p:start("Owner", true, "Music", 75), "second event after cooldown")
check(p:advance(80) == "Running", "music begins after announcement")
local now = 80
for beat = 1, 3 do
    check(p.beatIndex == beat and p.beat == "Move", "three movement phases")
    p:sample(1, 0, 0, true, now)
    p:sample(1, 2, 0, true, now + 1)
    p:sample(2, 0, 0, true, now)
    p:sample(2, 2, 0, true, now + 1)
    p:sample(3, 0, 0, true, now) -- Standing still throughout never earns participation.
    p:sample(4, 0, 0, true, now)
    p:sample(4, 100, 0, true, now + 1) -- A teleport is not dancing.
    now += 4
    check(p:advance(now) == "Beat" and p.beat == "Freeze", "three freeze phases")
    p:sample(1, 2.1, 0, true, now + 0.2)
    p:sample(1, 2.2, 0, true, now + 1)
    p:sample(2, 4, 0, true, now + 1)
    p:sample(5, 0, 0, true, now + 1) -- Entering at freeze cannot claim the earlier move.
    now += 3
    p:advance(now)
end
check(p.phase == "Finished" and p.participants[1].passes == 3, "three correct freeze completions")
check(p.participants[2].passes == 0 and p.awards[2] == 2, "mistake gives no completion points and no elimination")
check(p.awards[1] == 11 and not p.awards[3] and not p.awards[4] and not p.awards[5], "movement required, bounded one-time music reward")
p:advance(now + 6); p:advance(now + 55)
check(not p:start("Owner", true, "Relic", now + 55), "two events maximum per match")
local timeout = Policy.new(Config)
timeout:start("Owner", true, "Relic", 0); timeout:advance(5)
timeout:pickup(7, true); timeout:remove(7)
check(not timeout.carrier and not timeout.participants[7], "departed carrier frees relic without a future award")
check(timeout:advance(65) == "Finished" and not timeout.delivered, "search times out without a winner")
local interrupted = Policy.new(Config)
interrupted:start("Owner", true, "Relic", 0); interrupted:advance(5); interrupted:pickup(1, true)
check(interrupted:finish(10, true) and next(interrupted.scores) == nil, "round end cancels event without late rewards")
local chooser = function(low, _high) return low end
for _, role in ipairs({"Owner", "Spy", "CounterAgent", "Staff", "Waiting"}) do
    local neutral = Policy.new(Config)
    for _, key in ipairs({"Painting1", "Painting2", "Refreshment"}) do neutral:neutral(1, role, true, key, 0, chooser) end
    check(not neutral.incidentUsed and not neutral.pendingIncident, "only real Guest can build incident: " .. role)
end
local incident = Policy.new(Config)
check(not incident:neutral(9, "Guest", false, "Painting1", 0, chooser), "late guest has no progression")
for _ = 1, 8 do incident:neutral(1, "Guest", true, "Painting1", 0, chooser) end
check(not incident.incidentUsed, "repeated neutral action cannot farm progress")
incident:neutral(1, "Guest", true, "Painting2", 1, chooser)
check(not incident.incidentUsed, "three different activities required")
check(incident:neutral(1, "Guest", true, "Refreshment", 2, chooser), "legitimate guest triggers delayed event")
check(not incident.incident and incident.pendingIncident.due == 10, "no immediate public event at the revealing action")
check(not incident:neutral(2, "Guest", true, "Painting1", 2, chooser), "one incident per round globally")
check(not incident:advanceIncident(9), "incident delay not skipped")
check(incident:advanceIncident(10) == "Started" and incident.incident.kind == "Inspection", "first random incident type")
check(not incident:advanceIncident(34), "incident lasts bounded 25 seconds")
check(incident:advanceIncident(35) == "Finished" and not incident.incident, "incident automatically expires")
local blackout = Policy.new(Config)
for _, key in ipairs({"Painting1", "Painting2", "Painting3"}) do blackout:neutral(2, "Guest", true, key, 0, function(_, high) return high end) end
check(blackout.pendingIncident.kind == "Blackout" and blackout.pendingIncident.due == 15, "second random type and maximum delay")
local clock = Clock.new()
local paused = Policy.new(Config)
paused:start("Owner", true, "Relic", clock:now())
clock:advance(3); clock.running = false; clock:advance(100); paused:advance(clock:now())
check(paused.phase == "Announcing" and clock:now() == 3, "council pauses announcement and cooldown time")
clock.running = true; clock:advance(2); paused:advance(clock:now())
check(paused.phase == "Running" and paused.endsAt == 65, "resume preserves whole search duration")
local fired = false
clock:delay(1, function() fired = true end); clock:destroy(); clock:advance(100)
check(not fired and not clock.alive, "old event callbacks cannot affect new session")
local fresh = Policy.new(Config)
check(fresh.used == 0 and next(fresh.scores) == nil and not fresh.incidentUsed and not fresh.carrier, "new session clears limits, rewards and incident")
local practice = Practice.new(Config)
check(practice:get(1, 0).step == 1, "first visitor receives guided practice")
check(not practice:activity(1, "Noise", 1), "practice explains next step in sequence")
check(practice:activity(1, "Painting", 2), "practice inspection")
check(not practice:activity(1, "Painting", 3), "practice replay does not skip delivery")
check(practice:activity(1, "Refreshment", 30), "real delivery advances practice")
check(practice:activity(1, "Noise", 60) and practice:get(1, 60).step == 4, "safe reaction completes practice")
check(practice:get(1, 68).step == 1, "long waiting can repeat without any reward ledger")
check(practice:get(2, 10).step == 1 and practice:get(2, 100).step == 1, "90-second practice expires safely")
practice:clear()
check(next(practice.records) == nil, "countdown interrupts every practice")
print("PASS: " .. count .. " M3 event, incident and practice assertions")
