local Config = require("../src/shared/Config")
local Round = require("../src/server/RoundPolicy")
local Clock = require("../src/server/SessionClock")
local Plan = require("../src/server/RolePlan")
local count = 0
local function check(ok, message) assert(ok, message); count += 1 end
local function active(n)
    local r = Round.new(Config)
    check(r:tick(1, n) == "Countdown", "population starts countdown")
    check(r:tick(Config.COUNTDOWN_SECONDS, n) == "Start", "countdown expires")
    local ids = {}
    for i = 1, n do table.insert(ids, i) end
    check(r:activate(ids, 2), "start with spy")
    return r
end
local r = Round.new(Config)
check(not r:finish("Spy", "Extraction") and not r:extract(2), "waiting cannot finish")
check(not r:tick(100, 2) and r.phase == "Waiting", "under three explicit waiting")
check(r:tick(0, 3) == "Countdown", "three starts preparation")
check(not r:activate({1, 2}, 2), "cannot start undersized match")
check(r:tick(1, 2) == "Waiting", "leaving cancels countdown")
check(r:tick(0, 3) == "Countdown" and r.roundId == 2, "cancelled preparation invalidates old id")
check(not r:activate({1, 2, 3}, 999), "spy must be participant")
r = active(5)
check(not r:council(1), "council has startup delay")
r:tick(30, 5)
check(not r:council(9), "late join cannot call")
check(r:council(1), "one council after delay")
local saved, elapsed = r.savedRemaining, r.elapsed
check(not r:extract(2), "cannot extract during council")
check(not r:vote(1, 1, r.roundId), "self vote rejected")
check(not r:vote(1, 9, r.roundId), "absent target rejected")
check(not r:vote(9, 2, r.roundId), "late join vote rejected")
check(not r:vote(1, 2, r.roundId - 1), "stale round vote rejected")
check(r:vote(1, 2, r.roundId), "first vote")
check(not r:vote(1, 3, r.roundId), "immutable vote/replay rejected")
check(r:vote(3, 2, r.roundId) and not r:majority(), "two of five not majority")
check(r:vote(4, 2, r.roundId) and r:majority() == 2, "three of five majority")
r:tick(10, 5)
check(r.elapsed == elapsed and r.savedRemaining == saved, "active game clock paused")
local action, target = r:tick(15, 5)
check(action == "Search" and target == 2 and r.remaining == saved, "search resumes exact remaining time")
check(r.detained.id == 2 and r.detained.untilTime == elapsed + 12, "bounded search")
check(not r:council(1), "council cannot repeat")
r:tick(11, 5)
check(r.detained ~= nil, "search still active")
r:tick(1, 5)
check(not r.detained, "search ends automatically")
check(not r:extract(1), "only spy can extract")
check(r:extract(2) and r.result.winner == "Spy", "spy win")
check(not r:extract(2) and not r:finish("Defenders", "Timeout"), "result exactly once")
check(r:tick(12, 5) == "Reset", "automatic result reset")
check(r:tick(0, 5) == "Countdown" and not r.councilUsed and next(r.votes) == nil, "new round clears council")
check(next(r.cast) == nil, "new round restores each participant's single ballot")
check(r:activate({1, 2, 3, 4, 5}, 3), "new roles allowed next round")
check(not r:extract(2), "old spy has no privilege")
check(r:tick(Config.ROUND_SECONDS, 5) == "Results" and r.result.winner == "Defenders", "timeout defenders win")
check(not r:leave(3), "disconnect after result cannot finish twice")
for n = 3, 5 do
    local tied = active(n)
    tied:tick(30, n); tied:council(1)
    tied:vote(1, 2, tied.roundId)
    local resolved, searched = tied:tick(25, n)
    check(resolved == "Search" and not searched and not tied.detained, "abstentions count against majority")
end
local departed = active(5)
departed:tick(30, 5); departed:council(1)
departed:vote(1, 3, departed.roundId); departed:vote(4, 3, departed.roundId)
departed:leave(1)
check(departed.phase == "Council" and departed.votes[1] == nil, "owner/voter leaving does not hang council")
check(not departed:majority(), "departed votes discarded")
departed:leave(3)
check(departed.votes[4] == nil, "absent candidate removes votes")
check(departed.cast[4] and not departed:vote(4, 2, departed.roundId), "candidate departure never grants a second ballot")
check(departed:leave(2) and departed.result.reason == "SpyLeft", "spy departure ends paused round")
local ordinary = active(3)
check(not ordinary:leave(1) and ordinary.phase == "Active", "owner leaving preserves active game")
check(ordinary:leave(2) and ordinary.result.winner == "Defenders", "active spy departure")
for n = 1, 9 do
    local ids = {}
    for i = 1, n do table.insert(ids, i) end
    for seed = 1, 8 do
        local roles = Plan.assign(ids, function(i) return (seed % i) + 1 end)
        local totals = {}
        for _, role in pairs(roles) do totals[role] = (totals[role] or 0) + 1 end
        if n < 3 then check(next(roles) == nil, "no hidden roles below three")
        else
            check(totals.Owner == 1 and totals.Spy == 1 and totals.Guest >= 1, "composition always includes ambiguity")
            check((totals.CounterAgent or 0) == (if n >= 4 then 1 else 0), "agent composition")
            check((totals.Staff or 0) == (if n >= 5 then 1 else 0), "staff composition")
        end
    end
end
check(Plan.assign({1,2,3,4,5}, function() return 1 end)[1] ~= "Owner", "assignment does not follow join order")
local clock, fired = Clock.new(), 0
clock:delay(10, function() fired += 1 end)
clock:advance(4)
clock.running = false; clock:advance(60)
check(clock:now() == 4 and fired == 0, "door/request/NPC clock pauses")
clock.running = true; clock:advance(6)
check(fired == 1, "timer resumes once")
clock:advance(100)
check(fired == 1, "timer cannot reward twice")
clock:delay(1, function() fired += 100 end)
clock:destroy(); clock:advance(100)
check(fired == 1 and #clock.pending == 0, "old round callbacks invalidated")
local fresh = Clock.new(); fresh:advance(1)
check(fresh:now() == 1 and fired == 1, "new round time independent")
fresh:delay(0, function() fresh:destroy() end)
fresh:delay(0, function() fired += 100 end)
fresh:advance(0)
check(fired == 1, "invalidation also guards callbacks already due")
print("PASS: " .. count .. " M2 round, vote, role and generation assertions")
