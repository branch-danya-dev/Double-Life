-- Server-owned physical checkpoints; no step/reward command is exposed to clients.
local C={version=1,maximumSeconds=1800,steps={}}
local function step(key,chapter,target,action,text,kind)
    table.insert(C.steps,{key=key,chapter=chapter,target=target,action=action,text=text,kind=kind or "Observe"})
end
step("Welcome",1,"Welcome","Принять приглашение","Вечер только начинается. Возьмите приглашение у стойки и познакомьтесь с поместьем.")
step("Portrait",1,"Painting1","Рассмотреть портрет","Галерея, этаж 1. Кто-то развернул портрет к двери. Наблюдайте за предметами, а не угадывайте роли.")
step("Landscape",1,"Painting2","Осмотреть пейзаж","Вторая картина: на раме свежая пыль. Один след ещё ничего не доказывает.")
step("Signature",1,"Painting3","Сравнить подписи","Третья картина: подписи совпадают. Здесь можно заниматься обычными гостевыми делами.")
step("Order",2,"Service.Pantry","Принять поручение","Буфет, этаж 1. Гость в архиве наверху ждёт сок. Сначала примите заказ.","Order")
step("Tray",2,"Service.Pantry","Взять учебный поднос","Возьмите поднос. Само получение предмета ещё не означает выполненное поручение.","Pickup")
step("Delivery",2,"Service.Target2","Доставить сок","Архив, этаж 2. Донесите поднос до указанного столика через любую лестницу.","Delivery")
step("Invitation",2,"OwnerConsole","Показать приглашение","Пульт у кабинета, этаж 2. Покажите приглашение: короткий жест заменяет разговор.","Signal")
step("Access",2,"OwnerConsole","Открыть учебный кабинет","Разрешение действует только в этой сцене. Откройте кабинет и осмотрите помещение.","Access")
step("Seal",3,"Safe","Осмотреть пломбу","Сейф, кабинет. Пломба повреждена. Это свидетельство события, но не личности виновника.")
step("Clue",3,"TrainingClue","Поднять учебную улику","Подберите фрагмент возле сейфа. В настоящем матче улику можно передать или приложить к голосу.","Clue")
step("Journal",3,"ForensicLog","Прочитать запись","Журнал рядом: «Кабинет проветривали перед приёмом». Проверьте возможное объяснение.")
step("Window",3,"StudyWindow","Осмотреть оконную раму","След есть и у окна. Сопоставляйте место и время: персонаж рядом не обязательно виноват.")
step("EvidenceBoard",3,"EvidenceBoard","Оставить улику на столе","Вернитесь в читальню внизу. Положите находку на стол наблюдений.","DropClue")
step("Thanks",3,"EvidenceBoard","Поблагодарить жестом","Короткий знак благодарности понятен без чата. Обратите внимание на ответ сопровождающего.","Signal")
step("MusicStart",4,"Events.Console","Начать пробу музыки","Бальный зал, этаж 1. Зелёный свет — двигайтесь, золотой — замрите. Управление остаётся у вас.","MusicStart")
step("Music",4,"Events.Stage","Повторить пробу","Встаньте на цветную площадку. Сделайте несколько шагов на зелёный свет и остановитесь на золотой. Три коротких такта.","Music")
step("Bell",4,"Events.Bell","Проверить странный звук","Звонок у бального зала. Свет дрогнул — осмотрите две доступные линии освещения.","Blackout")
step("FuseWest",4,"EvidenceBoard","Проверить западную линию","Читальня, этаж 1. Западная линия цела. Сопровождающий осмотрит коридор.")
step("FuseUpper",4,"Service.Target2","Восстановить верхнюю линию","Архив, этаж 2. Верните свет. Сбой относится только к вашему знакомству с поместьем.","Restore")
step("Footsteps",5,"Social.TraceSpot","Прислушаться к шагам","Терраса, этаж 2. Слышны шаги. Смотрите на движение персонажа, не на имя над головой.","Signal")
step("Copy",5,"Safe","Взять учебную копию","Кабинет. Сопровождающий отвлёкся: заберите учебную копию. Это репетиция, без роли шпиона и без победы.","Copy")
step("Egress",5,"Social.Egress","Открыть выход из кабинета","Кнопка изнутри открывает путь обратно. В настоящем матче не забудьте заранее выбрать маршрут.","Access")
step("ReturnCopy",5,"Social.Delivery","Вернуть учебную копию","Приём коллекции, этаж 1. Верните копию на стойку; за репетицию нет матчевых наград.","ReturnCopy")
step("Finish",5,"MainExit","Завершить знакомство","Вы готовы к вечернему приёму. Полный матч начинается только с двумя людьми; роль вы получите уже там.","Finish")
function C.chapterStart(index)
    local chapter=C.steps[index].chapter
    while index>1 and C.steps[index-1].chapter==chapter do index-=1 end
    return index
end
return C
